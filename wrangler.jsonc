{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sunlanchang",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "sunlanchang.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
